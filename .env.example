# ตัวอย่างการตั้งค่าสำหรับรันในเครื่อง — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
# ใน Render ให้ตั้งค่าผ่าน Environment ของ service (render.yaml กำหนดไว้แล้ว)

NODE_ENV=development
PORT=3000

# PostgreSQL ในเครื่อง (ดู README หัวข้อ "PostgreSQL ในเครื่อง")
DATABASE_URL=postgresql://jarvis:<รหัสผ่านฐานข้อมูล>@localhost:5432/jarvis_dev

# สุ่มอย่างน้อย 32 ตัวอักษร เช่น: openssl rand -hex 32
SESSION_SECRET=<ค่าสุ่มอย่างน้อย-32-ตัวอักษร>

# origin ของหน้าเว็บที่อนุญาตให้ส่งคำขอเปลี่ยนข้อมูล (คั่นหลายค่าด้วย ,)
APP_ORIGIN=http://localhost:5173,http://localhost:3000

# true = แชตจำลอง ไม่ต้องมี API key / false = เรียก Claude Messages API
MOCK_MODE=true

# ใช้เมื่อ MOCK_MODE=false เท่านั้น
ANTHROPIC_API_KEY=<ใส่ API key ของคุณ>
ANTHROPIC_MODEL=claude-opus-5-5

# (ไม่บังคับ) งบ token โดยประมาณของประวัติที่ส่งให้ Claude ต่อคำขอ
# CONTEXT_TOKEN_BUDGET=12000

# สำหรับ npm test เท่านั้น — ฐานข้อมูลนี้จะถูกล้างทุกครั้งที่ทดสอบ
TEST_DATABASE_URL=postgresql://jarvis:<รหัสผ่านฐานข้อมูล>@localhost:5432/jarvis_test
